{
  "name": "tombo",
  "version": "1.4.0",
  "private": true,
  "description": "A modern, multilingual print UI that runs inside the FUJI XEROX ApeosPort web interface via a bookmarklet.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n mock,vite \"npm:mock\" \"vite\"",
    "mock": "tsx mock-printer/server.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.pdf.config.ts && vite build --config vite.pdfview.config.ts && tsx scripts/build-site.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "toner:publish": "tsx scripts/toner/publish.ts",
    "toner:install": "scripts/toner/install-agent.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "i18next": "^27.2.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^26.6.7",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "net-snmp": "^3.29.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
